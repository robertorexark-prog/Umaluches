@using Umaluches.Models.ViewModels
@model CatalogoViewModel
@{
    ViewData["Title"] = "Catálogo";
    // Rotamos los 3 colores de tarjeta de la paleta
    string[] coloresTarjeta = ["card-roja", "card-dorada", "card-rosa"];
    var indice = 0;
}

<section class="container mt-5">
    <h1 class="text-center mb-4">Catálogo de peluches Cuties</h1>

    <!--Filtros: el formulario usa GET para que la búsqueda quede en la URL-->
    <form asp-controller="Catalog" asp-action="Index" method="get" class="filtros-catalogo p-3 mb-4 rounded">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-lg-6">
                <label for="busqueda" class="form-label">Buscar</label>
                <input type="search" class="form-control" id="busqueda" name="busqueda" value="@Model.Busqueda"
                       placeholder="Nombre, anime o generación (ej. Cinderella Gray)">
            </div>
            <div class="col-6 col-lg-2">
                <label for="precioMin" class="form-label">Precio mínimo</label>
                <input type="number" class="form-control" id="precioMin" name="precioMin" value="@Model.PrecioMin" min="0" step="1" placeholder="$0">
            </div>
            <div class="col-6 col-lg-2">
                <label for="precioMax" class="form-label">Precio máximo</label>
                <input type="number" class="form-control" id="precioMax" name="precioMax" value="@Model.PrecioMax" min="0" step="1" placeholder="$1000">
            </div>
            <div class="col-12 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filtrar</button>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </div>
    </form>

    @if (TempData["CatalogoAviso"] is string aviso)
    {
        <div class="alert alert-warning" role="alert">@aviso</div>
    }

    @if (Model.Productos.Any())
    {
        <p class="text-muted mb-3">@Model.Productos.Count() peluche(s) encontrados</p>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No encontramos peluches con esos filtros. Prueba con otra búsqueda o rango de precio.
        </div>
    }

    <div class="row g-4">
        @foreach (var producto in Model.Productos)
        {
            <div class="col-12 col-sm-6 col-md-4">
                <div class="card h-100 mi-card @(coloresTarjeta[indice++ % coloresTarjeta.Length])">
                    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@producto.Id">
                        <partial name="_ImagenProducto" model="producto" />
                    </a>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@producto.Nombre</h5>
                        <p class="mb-2">
                            <span class="badge etiqueta-anime">@producto.Anime.Nombre</span>
                            <span class="badge etiqueta-generacion">@producto.Generacion.Nombre</span>
                        </p>
                        <p class="card-text">@producto.Descripcion</p>
                        <div class="d-flex justify-content-between align-items-center mt-auto mb-2">
                            <span class="precio">@producto.Precio.ToString("C")</span>
                            <partial name="_EtiquetaStock" model="producto.Stock" />
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="Catalog" asp-action="Details" asp-route-id="@producto.Id" class="btn btn-outline-primary">Ver detalles</a>
                            <partial name="_BotonComprar" model="producto" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
