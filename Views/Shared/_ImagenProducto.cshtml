@model Umaluches.Models.Producto
@* Muestra la imagen del producto o, si ImagenUrl está vacía, un placeholder SVG estilo Bootstrap *@
@if (!string.IsNullOrEmpty(Model.ImagenUrl))
{
    <img src="@Url.Content(Model.ImagenUrl!)" alt="Peluche Cuties de @Model.Nombre" class="card-img-top img-producto">
}
else
{
    <svg class="card-img-top img-producto placeholder-producto" xmlns="http://www.w3.org/2000/svg" role="img"
         aria-label="Imagen pendiente de @Model.Nombre" preserveAspectRatio="xMidYMid slice" viewBox="0 0 400 400">
        <title>@Model.Nombre</title>
        <rect width="100%" height="100%"></rect>
        <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle">@Model.Nombre</text>
    </svg>
}
