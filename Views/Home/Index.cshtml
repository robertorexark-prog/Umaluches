@using Umaluches.Models.ViewModels
@model InicioViewModel
@{
    ViewData["Title"] = "Tienda Cuties";
    // Rotamos los 3 colores de tarjeta de la paleta
    string[] coloresTarjeta = ["card-roja", "card-dorada", "card-rosa"];
    var indice = 0;
}

<!--Seccion hero-->
<div id="inicio" class="container mt-5 hero-section">
    <div class="row align-items-center">
        <div class="col-md-8">
            <h1 class="inicio">Bienvenido a Umaluches Cuties</h1>
            <p>
                La tienda de peluches oficiales de la línea <strong>Cuties</strong> de Uma Musume.
                Suaves, redonditas y listas para acompañarte en cada carrera: encuentra a tu
                uma favorita y llévala a casa.
            </p>
            <a href="#catalogo" class="btn btn-primary btn-lg">Ver destacados</a>
        </div>
        <div class="col-md-4 text-center">
            <img src="~/images/hero-cuties.jpg" alt="Peluches Cuties de Uma Musume" class="img-fluid rounded shadow">
        </div>
    </div>
</div>

<!--Seccion de destacados (desde la BD)-->
<section id="catalogo" class="container mt-5">
    <h2 class="text-center mb-4">Peluches destacados</h2>
    <div class="row g-4">
        @foreach (var producto in Model.Destacados)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 mi-card @(coloresTarjeta[indice++ % coloresTarjeta.Length])">
                    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@producto.Id">
                        <partial name="_ImagenProducto" model="producto" />
                    </a>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@producto.Nombre</h5>
                        <p class="card-text">@producto.Descripcion</p>
                        <p class="precio mt-auto">@producto.Precio.ToString("C")</p>
                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@producto.Id" class="btn btn-outline-primary">Lo quiero</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="text-center mt-4">
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-primary btn-lg">Ver catálogo completo</a>
    </div>
</section>

<!--Seccion de detalles (tabla con el stock real)-->
<section id="detalles" class="container mt-5">
    <h2 class="text-center mb-4">Detalles de los peluches</h2>
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Peluche</th>
                    <th scope="col">Anime</th>
                    <th scope="col">Tamaño</th>
                    <th scope="col">Precio</th>
                    <th scope="col">Disponibilidad</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model.Productos)
                {
                    <tr>
                        <td><a asp-controller="Catalog" asp-action="Details" asp-route-id="@producto.Id">@producto.Nombre</a></td>
                        <td>@producto.Anime.Nombre</td>
                        <td>20 cm</td>
                        <td>@producto.Precio.ToString("C")</td>
                        <td><partial name="_EtiquetaStock" model="producto.Stock" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<!--Seccion de contacto-->
<section id="contacto" class="container mt-5 mb-5">
    <h2 class="text-center mb-4">Contacto</h2>

    @if (TempData["ContactoOk"] is string ok)
    {
        <div class="alert alert-success" role="alert">@ok</div>
    }
    @if (TempData["ContactoError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <div class="alert alert-info" role="alert">
        ¿Quieres apartar un peluche, preguntar por envíos o pedir una uma que no está en el catálogo? Escríbenos:
    </div>
    <form class="mt-4" asp-controller="Home" asp-action="Contacto" method="post">
        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <input type="text" class="form-control" id="nombre" name="nombre" placeholder="Trainer" required>
        </div>
        <div class="mb-3">
            <label for="email" class="form-label">Correo electrónico</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="trainer@tracen.com" required>
        </div>
        <div class="mb-3">
            <label for="mensaje" class="form-label">Mensaje</label>
            <textarea class="form-control" id="mensaje" name="mensaje" rows="4" placeholder="Hola, me interesa el peluche de..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Enviar</button>
    </form>
</section>
