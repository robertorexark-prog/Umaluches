@using Umaluches.Models.ViewModels
@model RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<section class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="card tarjeta-login shadow">
                <div class="card-header text-center">
                    <h1 class="h3 mb-0">Crear cuenta</h1>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3">
                            <label asp-for="NombreUsuario" class="form-label"></label>
                            <input asp-for="NombreUsuario" class="form-control" placeholder="trainer_spica" autocomplete="username" />
                            <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label"></label>
                            <input asp-for="Correo" class="form-control" placeholder="tu@correo.com" autocomplete="email" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Contrasena" class="form-label"></label>
                            <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Contrasena" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="ConfirmarContrasena" class="form-label"></label>
                            <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Crear cuenta</button>
                    </form>

                    <p class="text-center small mt-3 mb-0">
                        ¿Ya tienes cuenta?
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Inicia sesión</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
